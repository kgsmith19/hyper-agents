{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "minLength": 1,
            "type": "string"
          },
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^AC[0-9]{1,3}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "claim",
          "check"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "task": {
      "maxLength": 4000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "task",
    "acceptance"
  ],
  "title": "Task input",
  "type": "object"
}
